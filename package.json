{
  "name": "inkfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A NES-difficulty platformer about a squid descending to the abyss",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "size": "node scripts/check-size.mjs",
    "smoke": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
